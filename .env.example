# === DATABASE ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mechind
POSTGRES_USER=mechind
POSTGRES_PASSWORD=change_me_in_production

# === REDIS ===
REDIS_URL=redis://localhost:6379/0

# === AI PROVIDER SELECTION ===
# LLM_PROVIDER: groq | gemini | openrouter | ollama  (default: groq)
# EMBEDDING_PROVIDER: gemini | groq | openrouter | ollama | local  (default: gemini)
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=gemini

# === GROQ (default LLM — fast, free tier available) ===
# Get key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# === GOOGLE GEMINI (default embeddings) ===
# Get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_GENERATION_MODEL=gemini-1.5-flash

# === OPENROUTER (optional) ===
# Get key at https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_SITE_URL=

# === OLLAMA (optional — local models) ===
# Run locally: https://ollama.ai/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# === HUGGING FACE (Custom Own Cloud Model) ===
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=deep101godhani/mendx-apex-v3
HUGGINGFACE_FALLBACK_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# === AUTHENTICATION ===
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=generate_me_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === APPLICATION ===
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=100
CORS_ORIGINS=["http://localhost:3000"]

# === STORAGE ===
UPLOAD_DIR=./uploads

# === RAG PIPELINE ===
EVIDENCE_SCORE_THRESHOLD=0.45
DISAMBIGUATION_THRESHOLD=0.3
MAX_RETRIEVAL_CHUNKS=20
RERANKER_TOP_K=10
CHUNK_MAX_TOKENS=800
CHUNK_MIN_TOKENS=100
CHUNK_OVERLAP_PCT=15
